# Copy to .env (gitignored) and edit — never commit real credentials here.
# docker-compose.yml already has safe local-dev defaults for all of these,
# so .env is optional unless you want to override something (e.g. point
# the api container at Neon instead of the local postgres container).

# Local postgres container creds (dummy, dev-only — fine as-is)
POSTGRES_DB=delivery_schedule_management
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# Connection string the api container actually uses.
# Default points at the local "postgres" service (see above).
# To use Neon instead: paste its connection string here and add
# "SSL Mode=Require;Trust Server Certificate=true" — Neon requires TLS.
# Real Neon credentials belong ONLY in your local .env, never in
# docker-compose.yml or any committed file.
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=delivery_schedule_management;Username=admin;Password=password
