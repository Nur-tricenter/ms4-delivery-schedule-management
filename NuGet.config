<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    NuGet feeds for MS4.

    The Nur.Tricenter.* platform kernels (security, access, integration, observability) are
    published to the organization's GitHub Packages feed. Everything else comes from nuget.org.

    AUTHENTICATION: GitHub Packages expects a classic personal access token with read:packages.
    Never put the token in this file. Set it once on the machine:

      setx NUGET_USERNAME YOUR_GITHUB_USER
      setx NUGET_TOKEN YOUR_TOKEN

    A restore only reaches the private feed when the pinned kernel version is missing from the
    global packages folder (~/.nuget/packages), so a machine that already holds it builds offline.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Nur-tricenter" value="https://nuget.pkg.github.com/Nur-tricenter/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Only the kernels are mapped to the organization feed. Mapping is exclusive: the public Joseco.*
    libraries must NOT be mapped here or restore fails with NU1101.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Nur-tricenter">
      <package pattern="Nur.Tricenter.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <Nur-tricenter>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
      <add key="ValidAuthenticationTypes" value="basic" />
    </Nur-tricenter>
  </packageSourceCredentials>

</configuration>
