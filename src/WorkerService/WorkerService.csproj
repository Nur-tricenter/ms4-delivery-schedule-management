<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>delivery_schedule_management.WorkerService</RootNamespace>
    <AssemblyName>delivery_schedule_management.WorkerService</AssemblyName>
  </PropertyGroup>

  <!--
    Nur-Tricenter platform convention: the worker references Infrastructure (Application arrives
    transitively) and is never registered in Consul — it serves no HTTP.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
